{
 "schema": "coverageops.field_tier_vectors",
 "version": 1,
 "contract": "API_CONTRACT v2.1",
 "owner": "CoverageOps repo (dashboard team) — the Android app copies this file; any change bumps version",
 "measure": "RSRP dBm (LTE and NR_NSA LTE anchor) / SS-RSRP dBm (NR_SA); half-open boundaries",
 "tiers": {
  "4": "excellent",
  "3": "good",
  "2": "medium",
  "1": "weak",
  "0": "marginal",
  "null": "unclassified"
 },
 "tier_thresholds_dbm": {
  "4": -85,
  "3": -95,
  "2": -105,
  "1": -115
 },
 "rules": [
  "service_state out_of_service|emergency_only -> 0 in every technology",
  "service_state power_off -> null",
  "in_service without RSRP (UMTS/GSM/NONE or null) -> null",
  "compare the value as is, no rounding"
 ],
