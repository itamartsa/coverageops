# ══════════════════════════════════════════════════════════════
#  CoverageOps – Environment Variables
#  Copy this file to .env and fill in all values before running
# ══════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_STRING_AT_LEAST_64_CHARS

ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Database ──────────────────────────────────────────────────
POSTGRES_DB=coverageops
POSTGRES_USER=coverageops
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# Full URL (used by backend service)
DATABASE_URL=postgresql://coverageops:REPLACE_WITH_STRONG_DB_PASSWORD@db:5432/coverageops

# ── CORS (comma-separated list of allowed origins) ────────────
# Development:
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Production – replace with your actual domain:
# CORS_ORIGINS=["https://coverageops.yourdomain.com"]

# ── Coverage Engine ───────────────────────────────────────────
# Path where SRTM elevation tiles are stored (inside container)
SRTM_DATA_DIR=/data/srtm

# Max radius allowed per analysis request (km)
MAX_ANALYSIS_RADIUS_KM=50.0

# Engine default grid resolution (used only when the engine is called without
# an explicit resolution; the API uses the adaptive resolution below)
COVERAGE_GRID_RESOLUTION=300

# Adaptive grid resolution for /api/coverage/analyze when "resolution" is omitted:
#   R = clamp(round(max_span_m / max(TARGET_CELL_M, dem_m_per_px)), MIN, MAX)
TARGET_CELL_M=40.0
MIN_GRID_RESOLUTION=60
# Also caps how far the analysis grid is extended toward a site outside the bbox
MAX_GRID_RESOLUTION=500
# Max bbox side (km) accepted by /analyze and /topo-overlay (larger → HTTP 400)
MAX_BBOX_SPAN_KM=400

# ── Terrain (Terrarium DEM tiles) ─────────────────────────────
# In-memory LRU cache size in tiles (~256 KB per tile → 512 ≈ 128 MB)
TILE_CACHE_SIZE=512
# Max tiles per elevation grid (zoom is lowered to fit this budget)
MAX_DEM_TILES=64
# Parallel tile downloads
TILE_FETCH_WORKERS=8
# Per-tile HTTP timeout and total deadline per grid (seconds)
TILE_FETCH_TIMEOUT_S=4.0
TILE_FETCH_DEADLINE_S=20.0
# Hard cap on DEM mosaic/output pixels (larger area → HTTP 413)
MAX_DEM_PIXELS=100000000

# Path to signal-server binary (optional – for Longley-Rice model)
# SIGNAL_SERVER_BIN=/usr/local/bin/signal-server

# ── Storage ───────────────────────────────────────────────────
# Legacy GeoJSON result files (new results are stored as a raster in the DB)
RESULTS_DIR=/data/results

# ── Frontend ──────────────────────────────────────────────────
# Development
VITE_API_URL=http://localhost:8000
# Production
# VITE_API_URL=https://coverageops.yourdomain.com
